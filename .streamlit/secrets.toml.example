# Copy into Streamlit Cloud > App settings > Secrets (never commit real keys)

# Default: Groq free tier (console.groq.com > API Keys)
GROQ_API_KEY = "gsk_..."
# GROQ_MODEL = "openai/gpt-oss-120b"   # change if Groq retires this model

# Web research for first-touch emails (tavily.com, free tier)
TAVILY_API_KEY = "tvly-..."

# Optional: Phoenix Cloud tracing (app.phoenix.arize.com > Settings)
# PHOENIX_COLLECTOR_ENDPOINT = "https://app.phoenix.arize.com/s/YOUR-SPACE"
# PHOENIX_API_KEY = "..."

# To use Claude instead:  LLM_PROVIDER = "anthropic"  and  ANTHROPIC_API_KEY = "sk-ant-..."
# To use OpenAI instead:  LLM_PROVIDER = "openai"     and  OPENAI_API_KEY = "sk-..."
